# Пароль от тестового сервера (см. CLAUDE.md, раздел «Сервер») — реальное
# значение хранится только локально, в .env (уже в .gitignore), сюда не пишется.
DEPLOY_SSH_PASSWORD=

# Firebase Cloud Messaging (push байерам). Путь ВНУТРИ контейнера к JSON
# сервис-аккаунта (Firebase Console → проект ServiceBox54 → Project Settings →
# Service accounts → Generate new private key). Файл кладётся на сервер в
# /var/www/servicebox/firebase-credentials.json (в .gitignore), в контейнере он
# виден как /var/www/html/firebase-credentials.json. Пусто / нет файла →
# push-канал молча выключен (как MAIL_MAILER=log до настройки SMTP).
FIREBASE_CREDENTIALS_PATH=

# ─────────────────────────────────────────────────────────────────────────────
#  ServiceBox — серверный .env
#
#  Кладётся ВРУЧНУЮ в /var/www/servicebox/.env до первого деплоя (он вне git,
#  deploy.sh его только читает и дописывает недостающее).
#
#  Один и тот же файл читают docker compose (подстановка ${...} в
#  docker-compose.prod.yml) и Laravel внутри контейнера (bind-mount). Значения
#  из секции environment: compose'а перекрывают одноимённые ключи внутри
#  контейнера — пока значение задано в одном месте, расхождения нет.
#
#  Полный список ключей — ниже. Пустой ключ в секции «интеграции» = канал молча
#  выключен (как MAIL_MAILER=log до настройки SMTP).
# ─────────────────────────────────────────────────────────────────────────────


# ═══ СЕРВЕР — обязательное ═══════════════════════════════════════════════════

APP_NAME=ServiceBox
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show. НЕ пересоздавать при переезде — расшифровка
# всех зашифрованных полей в БД завязана на него, восстановления нет.
APP_KEY=
APP_LOCALE=ru

# ⟵ ЕДИНСТВЕННАЯ переменная домена. Ссылки в письмах и ботах, Storage::url(),
#    CORS (config/cors.php), сборка бандлов admin/widget в deploy.sh,
#    регистрация вебхуков (webhooks:register) — всё выводится отсюда.
#    При ребрендинге меняется ТОЛЬКО здесь (+ пересборка mobile-флейвора,
#    см. mobile/flavors/*.json, и перевыпуск сертификата на новый домен).
APP_URL=https://example.com

# Пусто = APP_URL. Задавать, только если админку вынесли на отдельный поддомен.
FRONTEND_URL=

# Доп. доверенные origin для CORS, список через запятую (сверх APP_URL / FRONTEND_URL).
CORS_ALLOWED_ORIGINS=

DB_CONNECTION=pgsql
DB_DATABASE=servicebox
DB_USERNAME=servicebox
DB_PASSWORD=

# Reverb (WebSocket-чат). REVERB_APP_KEY впекается в бандл админки и вшит в APK —
# НЕ менять при переезде, иначе установленные приложения потеряют realtime.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=


# ═══ ИНТЕГРАЦИИ — пусто = канал выключен ════════════════════════════════════

# Почта (SMTP). Пусто → письма уходят в storage/logs, не отправляются.
# Для нового домена: своя учётка + SPF/DKIM/DMARC, иначе письма в спам.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="ServiceBox"

# Telegram-бот (уведомления шоперам, привязка байеров). Вебхук ставит
# webhooks:register на APP_URL/api/webhook/telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SECRET_TOKEN=

# MAX-бот. Токен раньше был вшит в deploy.sh открытым текстом и утёк в публичную
# историю git — перевыпустить. Вебхук: APP_URL/api/webhook/max/<MAX_WEBHOOK_SECRET>.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=

# ЮKassa (эквайринг). При переезде: return_url и URL уведомлений в ЛК ЮKassa
# правятся вручную — API самообслуживания там нет.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Firebase Cloud Messaging (push байерам). Путь ВНУТРИ контейнера к JSON
# сервис-аккаунта (Firebase Console → проект ServiceBox54 → Project Settings →
# Service accounts → Generate new private key). Файл кладётся на сервер в
# /var/www/servicebox/firebase-credentials.json (в .gitignore), в контейнере
# виден как /var/www/html/firebase-credentials.json.
FIREBASE_CREDENTIALS_PATH=


# ═══ ТОЛЬКО ЛОКАЛЬНО — на сервер не класть ═════════════════════════════════

# Пароль от тестового сервера для plink/pscp из локальной рабочей копии.
DEPLOY_SSH_PASSWORD=


# ═══ УСТАРЕВШЕЕ — если есть в текущем .env, можно удалить ═══════════════════
#
# deploy.sh теперь выводит эти значения из APP_URL на этапе сборки, а
# docker-compose.prod.yml задаёт внутрисетевой reverb-хост сам:
#   VITE_REVERB_APP_KEY  VITE_REVERB_HOST  VITE_REVERB_PORT  VITE_REVERB_SCHEME
#   REVERB_HOST  REVERB_PORT  REVERB_SCHEME
